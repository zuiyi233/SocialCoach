# ── Provider ────────────────────────────────────────────────────
# anthropic (default) | openai
# "openai" also covers any OpenAI-compatible endpoint: vLLM, Ollama,
# OpenRouter, LiteLLM, DeepSeek, Moonshot, …
LLM_PROVIDER=anthropic

# Credential. Provider-native names still work as fallbacks:
#   anthropic → ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN
#   openai    → OPENAI_API_KEY
LLM_API_KEY=

# Custom endpoint. Overrides the provider default; leave empty for the
# official API. Include the version path your gateway expects, e.g.
#   http://localhost:11434/v1        (Ollama)
#   https://openrouter.ai/api/v1     (OpenRouter)
# Provider-native names also work: ANTHROPIC_BASE_URL / OPENAI_BASE_URL
LLM_BASE_URL=

# ── Model routing ──────────────────────────────────────────────
# Fast model: role-play turns, hints, coach replies, scheduling, scenario generation
# Smart model: post-practice assessment reports
# Defaults are claude-sonnet-5 / claude-opus-5 for anthropic and
# gpt-4.1-mini / gpt-4.1 for openai — set them explicitly for any gateway.
LLM_FAST_MODEL=
LLM_SMART_MODEL=

# ── Bring-your-own-key ─────────────────────────────────────────
# Learners can always add their own credentials in Settings → 模型; those stay
# in their browser and call the provider directly, never touching this server.
# Set this to force it — a public demo then costs the deployer nothing.
# LLM_REQUIRE_BYOK=true

# ── OpenAI compatibility ───────────────────────────────────────
# Newer OpenAI models require max_completion_tokens; most compatible
# servers only know max_tokens (the default). Switch if your endpoint
# rejects max_tokens.
# LLM_OPENAI_TOKEN_PARAM=max_completion_tokens
# For compatible providers such as DeepSeek, short JSON tasks can disable thinking.
# Complex evidence verification keeps its own bounded reasoning budget.
# LLM_OPENAI_THINKING=disabled
# `budget` additionally sends the numeric `thinking:{type:"enabled",budget_tokens}`
# the reasoning tier asks for. Measured on this project's gateway: 3480 reasoning
# tokens under an 8192 budget versus 22 under `reasoning_effort:"high"` for the same
# task — without this the tier is only a label plus a raised output ceiling. Official
# OpenAI rejects the field, so it stays opt-in per deployment.
# LLM_OPENAI_THINKING=budget
# Which model ids may reason during the assessment fact-check. A model that
# answers worse while thinking — Sensenova's audit did — stays out of this list,
# because the step then gets no reasoning budget at all.
# LLM_REASONED_MODELS=deepseek-

# ── Reasoning depth ────────────────────────────────────────────
# fast (default) changes nothing: each task keeps its own intent. balanced and
# deep make every call think and raise the output ceiling together — up to 8K
# thinking per dialogue turn, up to 32K on the debrief path. Better answers,
# slower, and the shared pool drains faster.
# LLM_REASONING_TIER=balanced

# ── Optional user feedback → Feishu Bitable ─────────────────────
# Server-only credentials. Use a dedicated self-built Feishu application.
# Without all four values, /api/feedback reports unavailable (never fake success).
FEEDBACK_FEISHU_APP_ID=
FEEDBACK_FEISHU_APP_SECRET=
FEEDBACK_FEISHU_BASE_TOKEN=
FEEDBACK_FEISHU_TABLE_ID=
# Set ModelScope / Vercel / Self-hosted for the receiving table.
FEEDBACK_DEPLOYMENT=
FEEDBACK_VERSION=

# ── Optional anonymous usage analytics → the same Feishu Base ──────
# Reuses the FEEDBACK_FEISHU_* app and Base above. Set ONE of the two:
#   prefix → one table per month, <prefix>_YYYY_MM, created by the server
#            when missing (needs the bitable:app scope)
#   id     → a single pinned table; Base tables hold 20,000 rows, so watch it
# Without either, /api/track reports unavailable and the client never sends.
ANALYTICS_FEISHU_TABLE_PREFIX=
ANALYTICS_FEISHU_TABLE_ID=
# Test hook only: point the Feishu client at a mock server.
# FEISHU_BASE_URL=http://127.0.0.1:3200/open-apis

# Required to enable shared model generation in production. Only anonymous
# token/concurrency counters are stored; practice archives remain on device.
# A Redis REST endpoint supporting atomic EVAL (e.g. Upstash). Fail closed.
LLM_BUDGET_REDIS_URL=
LLM_BUDGET_REDIS_TOKEN=
# Initializes the central policy only if absent. Change an existing policy
# explicitly in Redis; ordinary instances never lower it during a rollout.
LLM_BUDGET_DAILY_TOKENS=100000000
# Keep it at or below what the model tier actually answers. Measured: 3 concurrent
# practice-sized requests ran clean, 4 began returning `429 rpm exhausted`.
LLM_BUDGET_CONCURRENCY=3
# Also configure a hard monetary ceiling at the model provider.

# ── Public canonical address ───────────────────────────────────
# robots.txt and sitemap.xml build absolute URLs from this value. It defaults
# to the Vercel host, which is also the host deep links must use — the
# geo-split share domain redirects and drops subpaths. Set it for self-hosting.
# NEXT_PUBLIC_SITE_URL=https://socialcoach-ai.vercel.app
