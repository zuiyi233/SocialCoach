# 线上环境变量。复制成 .env.production 后填写（已被 .gitignore 覆盖）。

# ── 模型 ────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
LLM_API_KEY=
LLM_FAST_MODEL=glm-5.3-flash
LLM_SMART_MODEL=glm-5.3
# thinking:{type:"disabled"} 关掉思考；改成 budget 则连思考预算数字一起发
# （thinking:{type:"enabled",budget_tokens:N}）。本网关实测两者都被接受，且
# budget 才真正改变思考量：同一题 8192 预算花掉 3480 reasoning tokens，
# 而 reasoning_effort:"high" 只花 22。官方 OpenAI 不认识这个字段，别开。
LLM_OPENAI_THINKING=disabled
# 思考档位：留空即 fast（各任务保持原本的设置）。balanced / deep 会让每次调用都思考，
# 逐回合最多 8K 思考、复盘那条链路最多 32K，共享池也掉得更快。
# 实测代价是确定的：同一条回合链路 p50 3.9s→9.7s、p90 6.5s→33.8s。
# 收益不是确定的：在不开 budget 的档位上，缺陷率差异落在噪声里（n=138，p>0.2）。
# LLM_REASONING_TIER=balanced

# ── 额度保护（公开部署必须认真设）──────────────────────
# 每 IP 每小时的调用次数。一场完整练习约 12–14 次。
RATE_LIMIT_PER_IP=45
# 全站每天的上限 —— 这才是保护钱包的那道线。
# 2000 ≈ 150 场练习/天。想更保守就调低。
RATE_LIMIT_GLOBAL_DAILY=2000

# 想让所有人都自带 key、你一分钱不花，就打开这个（届时上面的 LLM_API_KEY 可以留空）
# LLM_REQUIRE_BYOK=true

# Shared generation is disabled in production until its atomic budget is configured.
LLM_BUDGET_REDIS_URL=
LLM_BUDGET_REDIS_TOKEN=
LLM_BUDGET_DAILY_TOKENS=2000000
# 并发闸门要低于模型档位真正能回答的量：实测 3 路并发跑几百次干净，
# 4 路就开始回 429 rpm exhausted。换更贵的档位再往上调。
LLM_BUDGET_CONCURRENCY=3

# robots.txt 与 sitemap.xml 的绝对地址来源；不设则用 Vercel 直连域名。
# 自部署时填你自己的 https 源；地域分流短域名会丢子路径，不要填它。
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
