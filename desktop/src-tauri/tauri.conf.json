{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SocialCoach",
  "mainBinaryName": "socialcoach-desktop",
  "version": "0.1.0",
  "identifier": "com.socialcoach.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../app dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm run runtime",
    "frontendDist": "http://127.0.0.1:3210"
  },
  "plugins": {},
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SocialCoach",
        "url": "about:blank",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": false,
    "resources": {
      "../sidecar/runtime": "runtime"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
